# LocalHer Environment Configuration Template
# Copy this file to .env and configure your credentials

# Django Secret Key & Debug Mode
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True

# Database Configuration (PostgreSQL URL for Render or Local)
# Format: postgres://username:password@hostname:5432/database_name
# Example for Render PostgreSQL: postgres://localher_db_user:password123@dpg-xxx-a.render.com/localher_db
# If left commented or empty, Django gracefully defaults to local SQLite for offline development.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/localher_db

# Cloudinary Storage Configuration (Optional for persistent media uploads on Render)
# Sign up at https://cloudinary.com/ to get your credentials
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Automated Render Superuser Creation (Optional)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=your_secure_admin_password
# DJANGO_SUPERUSER_EMAIL=admin@localher.com
